# QuieroEso environment. Copy to `.env` for local development:
#   pnpm env:setup   (copies this file to .env with fresh local secrets)
# Never commit real credentials. Production secrets live only in Railway.

NODE_ENV=development
# local | test | staging | production (mock providers are refused in staging/production)
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (docker compose exposes it on 54320)
DATABASE_URL=postgresql://quieroeso:quieroeso@localhost:54320/quieroeso
TEST_DATABASE_URL=postgresql://quieroeso:quieroeso@localhost:54320/quieroeso_test

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Local mock server for Google, Mercado Libre and Mercado Pago (apps/mock-providers)
MOCK_PROVIDERS=true
MOCK_PROVIDERS_PUBLIC_URL=http://localhost:4010
MOCK_PROVIDERS_INTERNAL_URL=http://localhost:4010

# Google OAuth (required when MOCK_PROVIDERS=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Libre application (required when MOCK_PROVIDERS=false)
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_API_BASE_URL=https://api.mercadolibre.com

# Mercado Pago application (required when MOCK_PROVIDERS=false)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_AUTH_BASE_URL=https://auth.mercadopago.com
MP_API_BASE_URL=https://api.mercadopago.com

# Token vault: AES-256-GCM keys (base64, 32 bytes). Add V2, V3... to rotate.
TOKEN_ENCRYPTION_KEY_V1=replace-with-base64-32-bytes
ACTIVE_TOKEN_KEY_VERSION=1

# HMAC secret for daily-rotated IP hashes used by rate limits
IP_HASH_SECRET=replace-with-at-least-32-random-characters

# Minimum contribution in cents (100000 = $1.000 ARS)
MIN_CONTRIBUTION_MINOR=100000
