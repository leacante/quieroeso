{
  "name": "quieroeso",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @quieroeso/db generate",
    "db:migrate": "pnpm --filter @quieroeso/db migrate:dev",
    "db:deploy": "pnpm --filter @quieroeso/db migrate:deploy",
    "db:seed": "pnpm --filter @quieroeso/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:setup": "node scripts/setup-env.mjs",
    "railway:typecheck": "tsc -p .railway/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "railway": "3.11.0",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1"
  }
}
