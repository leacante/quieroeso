// QuieroEso data model. See docs/adr/0003-data-model.md for deviations from the MVP plan.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth
// ---------------------------------------------------------------------------

model User {
  id            String                 @id
  name          String
  email         String                 @unique
  emailVerified Boolean                @default(false)
  image         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions      Session[]
  accounts      Account[]
  lists         WishList[]
  entitlement   FreeTierEntitlement?
  mercadoPago   MercadoPagoConnection?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  /// Provider subject. For Google this is the stable `sub` claim.
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Lists
// ---------------------------------------------------------------------------

enum ListVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum FundingMode {
  WISHLIST
  PER_ITEM
}

enum ItemSourceType {
  MERCADOLIBRE
  MANUAL
}

enum ItemAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

model WishList {
  id                   String               @id @default(cuid())
  ownerId              String
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title                String
  description          String?
  slug                 String               @unique
  visibility           ListVisibility       @default(PRIVATE)
  fundingMode          FundingMode          @default(WISHLIST)
  /// SHA-256 of the unlisted share token; used for lookups.
  shareTokenHash       String?              @unique
  /// AES-256-GCM envelope of the share token so the owner can copy the link again.
  shareTokenEncrypted  String?
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  items                ListItem[]
  promotionEntitlement FreeTierEntitlement? @relation("FirstPublishedList")

  @@index([ownerId, archivedAt])
  @@index([visibility, archivedAt])
}

model ListItem {
  id                String           @id @default(cuid())
  listId            String
  list              WishList         @relation(fields: [listId], references: [id], onDelete: Restrict)
  position          Int
  sourceType        ItemSourceType
  sourceUrl         String?
  externalId        String?
  /// ITEM or CATALOG_PRODUCT for Mercado Libre sources.
  externalKind      String?
  /// Presentation fields; the owner may edit them.
  title             String
  notes             String?
  imageUrl          String?
  /// Last known source data (ProductSnapshotInput), kept untouched by owner edits.
  sourceSnapshot    Json?
  priceMinor        BigInt?
  targetAmountMinor BigInt?
  currency          String           @default("ARS")
  availability      ItemAvailability @default(UNKNOWN)
  lastSyncedAt      DateTime?
  lastSyncError     String?
  /// Set while a refresh worker owns the row; stale claims expire.
  syncClaimedAt     DateTime?
  feeRateBps        Int              @default(100)
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  freeSlot          FreeProductSlot?
  contributions     Contribution[]

  @@unique([listId, position])
  @@index([listId, archivedAt])
  @@index([externalId])
  @@index([sourceType, lastSyncedAt])
}

// ---------------------------------------------------------------------------
// Platform fee promotion
// ---------------------------------------------------------------------------

/// Fixed on the first successful publication of any of the user's lists; never reassigned.
model FreeTierEntitlement {
  id                   String            @id @default(cuid())
  userId               String            @unique
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  firstPublishedListId String            @unique
  firstPublishedList   WishList          @relation("FirstPublishedList", fields: [firstPublishedListId], references: [id], onDelete: Restrict)
  assignedAt           DateTime          @default(now())
  slots                FreeProductSlot[]
}

/// One of the eight 0% slots. `consumedAt` is set on the item's first approved
/// contribution and is permanent; unconsumed slots are released when their item goes.
model FreeProductSlot {
  id            String              @id @default(cuid())
  entitlementId String
  entitlement   FreeTierEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  slotNumber    Int
  listItemId    String?             @unique
  listItem      ListItem?           @relation(fields: [listItemId], references: [id], onDelete: Restrict)
  assignedAt    DateTime?
  consumedAt    DateTime?
  releasedAt    DateTime?

  @@unique([entitlementId, slotNumber])
}

// ---------------------------------------------------------------------------
// Mercado Pago
// ---------------------------------------------------------------------------

enum MercadoPagoConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

model MercadoPagoConnection {
  id                    String                      @id @default(cuid())
  userId                String                      @unique
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  mercadoPagoUserId     String                      @unique
  /// AES-256-GCM envelopes; see packages/integrations/src/crypto/token-vault.ts
  encryptedAccessToken  String
  encryptedRefreshToken String
  tokenExpiresAt        DateTime
  keyVersion            Int
  status                MercadoPagoConnectionStatus @default(ACTIVE)
  liveMode              Boolean                     @default(false)
  scope                 String?
  lastRefreshedAt       DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

/// Single-use OAuth `state` with its PKCE verifier (encrypted), valid for 10 minutes.
model OAuthState {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  stateHash             String    @unique
  encryptedCodeVerifier String
  returnPath            String?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([expiresAt])
}

enum ContributionStatus {
  CREATED
  CHECKOUT_CREATED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

model Contribution {
  id                     String             @id @default(cuid())
  listItemId             String
  listItem               ListItem           @relation(fields: [listItemId], references: [id], onDelete: Restrict)
  amountMinor            BigInt
  currency               String             @default("ARS")
  contributorName        String?
  contributorMessage     String?
  status                 ContributionStatus @default(CREATED)
  platformFeeRateBps     Int
  platformFeeAmountMinor BigInt
  /// Mercado Pago user id of the collector at creation time; payments must match it.
  collectorId            String
  mpPreferenceId         String?            @unique
  mpPaymentId            String?            @unique
  mpStatusDetail         String?
  /// Client-supplied Idempotency-Key of the checkout request.
  idempotencyKey         String             @unique
  approvedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([listItemId, status])
  @@index([status, createdAt])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  topic           String?
  resourceId      String?
  payloadHash     String
  result          String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, resourceId])
}

// ---------------------------------------------------------------------------
// Abuse controls and audit
// ---------------------------------------------------------------------------

/// Fixed-window counters. `key` never contains raw IPs (daily HMAC instead).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorUserId, createdAt])
}
